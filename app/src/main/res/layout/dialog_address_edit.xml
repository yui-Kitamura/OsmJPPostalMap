<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="現在の値"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:id="@+id/address_current"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- addr:full が設定されている場合のみ表示 -->
        <LinearLayout
            android:id="@+id/address_full_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="住所全体"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/address_full_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:hint="addr:full"
                android:importantForAutofill="no"
                android:inputType="text"
                android:textSize="14sp" />

        </LinearLayout>

        <Button
            android:id="@+id/address_expand_hierarchy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="タグ階層で入力をする" />

        <!-- 階層が全空欄のときだけ表示する。入力済みの値を失わせないため -->
        <Button
            android:id="@+id/address_collapse_hierarchy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="full入力に戻る"
            android:visibility="gone" />

        <!-- JpAddress の各フィールドの行を AddressEditDialog から追加する -->
        <LinearLayout
            android:id="@+id/address_hierarchy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

    </LinearLayout>

</ScrollView>
