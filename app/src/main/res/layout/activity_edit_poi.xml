<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/edit_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_red">

    
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/top_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/white"
            android:padding="8dp"
            android:visibility="gone"
            android:elevation="8dp" />

        <androidx.appcompat.widget.AppCompatImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back_postbox"
            android:contentDescription="@string/back" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/edit_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?android:attr/colorBackground">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

        <TextView
            android:id="@+id/edit_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/text_location_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="?attr/colorError"
            android:text="@string/location_status_fetching"
            android:layout_marginBottom="8dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="200dp">

            <org.osmdroid.views.MapView
                android:id="@+id/edit_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_lock_map"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_margin="8dp"
                android:background="@drawable/bg_menu_button"
                android:src="@drawable/ic_lock_locked"
                app:tint="?attr/colorOnSurface"
                android:scaleType="centerInside"
                android:padding="8dp"
                android:contentDescription="地図のロック"
                android:layout_gravity="top|start" />

            <androidx.appcompat.widget.AppCompatImageButton
                android:id="@+id/btn_my_location"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="bottom|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_menu_button"
                android:src="@drawable/ic_my_location"
                app:tint="?attr/colorOnSurface"
                android:contentDescription="現在地" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="-16dp"
            android:layout_marginBottom="16dp"
            android:background="@color/map_overlay_bg"
            android:paddingHorizontal="4dp"
            android:paddingVertical="2dp"
            android:text="@string/osm_copyright"
            android:textColor="@color/map_overlay_text"
            android:textSize="10sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_tag_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="営業時間 (opening_hours)"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_tag_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/layout_opening_hours_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TableLayout
                android:id="@+id/table_opening_hours"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1,2,3"
                android:layout_marginBottom="8dp"
                android:padding="1dp"
                android:background="@color/gray_divider">
                <TableRow>
                    <TextView android:text="" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="@string/label_opening" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="@string/label_closing" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="@string/label_break_time" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="@string/label_off" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                </TableRow>
                <TableRow android:gravity="center_vertical">
                    <TextView android:text="@string/day_weekday" android:textStyle="bold" android:padding="2dp" android:textSize="11sp" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp" android:layout_height="match_parent"/>
                    <EditText android:id="@+id/edit_oh_wd_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <EditText android:id="@+id/edit_oh_wd_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp">
                        <EditText android:id="@+id/edit_oh_wd_break_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="1dp"/>
                        <EditText android:id="@+id/edit_oh_wd_break_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                    </LinearLayout>
                    <CheckBox android:id="@+id/check_oh_wd_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                </TableRow>
                <TableRow android:gravity="center_vertical">
                    <TextView android:text="@string/day_saturday" android:textStyle="bold" android:padding="2dp" android:textSize="11sp" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp" android:layout_height="match_parent"/>
                    <EditText android:id="@+id/edit_oh_sa_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <EditText android:id="@+id/edit_oh_sa_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp">
                        <EditText android:id="@+id/edit_oh_sa_break_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="1dp"/>
                        <EditText android:id="@+id/edit_oh_sa_break_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                    </LinearLayout>
                    <CheckBox android:id="@+id/check_oh_sa_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                </TableRow>
                <TableRow android:gravity="center_vertical">
                    <TextView android:text="@string/day_holiday" android:textStyle="bold" android:padding="2dp" android:textSize="11sp" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp" android:layout_height="match_parent"/>
                    <EditText android:id="@+id/edit_oh_ph_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <EditText android:id="@+id/edit_oh_ph_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp">
                        <EditText android:id="@+id/edit_oh_ph_break_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="1dp"/>
                        <EditText android:id="@+id/edit_oh_ph_break_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                    </LinearLayout>
                    <CheckBox android:id="@+id/check_oh_ph_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">
                <Button
                    android:id="@+id/btn_oh_copy_to_sa"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_copy_wd_to_sa"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btn_oh_copy_to_ph"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_copy_sa_to_ph"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_special_note_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_special_note"
            android:layout_marginBottom="16dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_special_note_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textMultiLine" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/layout_limited_service_edit_root"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/gray_divider"
                android:layout_marginVertical="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_limited_service"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="4dp"/>

            <RadioGroup
                android:id="@+id/radio_limited_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">
                <RadioButton
                    android:id="@+id/radio_ls_yes"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/available" />
                <RadioButton
                    android:id="@+id/radio_ls_no"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/none" />
                <RadioButton
                    android:id="@+id/radio_ls_unknown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/unknown" />
            </RadioGroup>

            <TableLayout
                android:id="@+id/table_limited_service"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="1,2,3"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                android:padding="1dp"
                android:background="@color/gray_divider">
                <TableRow>
                    <TextView android:text="" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="@string/label_opening" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="@string/label_closing" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="@string/label_break_time" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="@string/label_off" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                </TableRow>
                <TableRow android:gravity="center_vertical">
                    <TextView android:text="@string/day_weekday" android:textStyle="bold" android:padding="2dp" android:textSize="11sp" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp" android:layout_height="match_parent"/>
                    <EditText android:id="@+id/edit_ls_wd_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <EditText android:id="@+id/edit_ls_wd_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp">
                        <EditText android:id="@+id/edit_ls_wd_break_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="1dp"/>
                        <EditText android:id="@+id/edit_ls_wd_break_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                    </LinearLayout>
                    <CheckBox android:id="@+id/check_ls_wd_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                </TableRow>
                <TableRow android:gravity="center_vertical">
                    <TextView android:text="@string/day_saturday" android:textStyle="bold" android:padding="2dp" android:textSize="11sp" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp" android:layout_height="match_parent"/>
                    <EditText android:id="@+id/edit_ls_sa_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <EditText android:id="@+id/edit_ls_sa_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp">
                        <EditText android:id="@+id/edit_ls_sa_break_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="1dp"/>
                        <EditText android:id="@+id/edit_ls_sa_break_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                    </LinearLayout>
                    <CheckBox android:id="@+id/check_ls_sa_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                </TableRow>
                <TableRow android:gravity="center_vertical">
                    <TextView android:text="@string/day_holiday" android:textStyle="bold" android:padding="2dp" android:textSize="11sp" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp" android:layout_height="match_parent"/>
                    <EditText android:id="@+id/edit_ls_ph_open" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <EditText android:id="@+id/edit_ls_ph_close" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center" android:layout_margin="1dp"/>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_cell_header" android:layout_margin="1dp">
                        <EditText android:id="@+id/edit_ls_ph_break_start" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="-" android:padding="1dp"/>
                        <EditText android:id="@+id/edit_ls_ph_break_end" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:hint="--:--" android:inputType="time" android:background="@drawable/bg_edit_time_cell" android:padding="4dp" android:textSize="16sp" android:gravity="center"/>
                    </LinearLayout>
                    <CheckBox android:id="@+id/check_ls_ph_off" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                </TableRow>
            </TableLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_collection_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TableLayout
                android:id="@+id/table_collection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:stretchColumns="0,1,2"
                android:layout_marginBottom="8dp"
                android:padding="1dp"
                android:background="@color/gray_divider">
                <TableRow>
                    <TextView android:text="平日" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView android:text="土曜" android:gravity="center" android:textStyle="bold" android:padding="2dp" android:textSize="12sp" android:background="@drawable/bg_cell_header" android:layout_margin="1dp"/>
                    <TextView
                        android:id="@+id/header_sun_ph"
                        android:text="日祝"
                        android:gravity="center"
                        android:textStyle="bold"
                        android:padding="2dp"
                        android:textSize="12sp"
                        android:background="@drawable/bg_cell_header"
                        android:layout_margin="1dp"/>
                </TableRow>
                <TableRow>
                    <Button
                        android:id="@+id/btn_copy_to_sat"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="→土曜"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textSize="12sp" />
                    <Button
                        android:id="@+id/btn_copy_to_sun"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="→日祝"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:textSize="12sp" />
                    <View android:layout_width="0dp" android:layout_height="0dp" />
                </TableRow>
                <TableRow>
                    <CheckBox
                        android:id="@+id/check_col_wd_off"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/postbox_no_collection"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:background="@drawable/bg_cell_header"
                        android:layout_margin="1dp"/>
                    <CheckBox
                        android:id="@+id/check_col_sa_off"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/postbox_no_collection"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:background="@drawable/bg_cell_header"
                        android:layout_margin="1dp"/>
                    <CheckBox
                        android:id="@+id/check_col_ph_off"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:text="@string/postbox_no_collection"
                        android:textSize="10sp"
                        android:gravity="center"
                        android:background="@drawable/bg_cell_header"
                        android:layout_margin="1dp"/>
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:id="@+id/layout_holiday_warning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:background="@color/warning_bg"
                android:visibility="gone"
                android:layout_marginBottom="8dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/msg_no_holiday_times"
                    android:textColor="@color/warning_text"
                    android:textSize="12sp" />
                <Button
                    android:id="@+id/btn_apply_sun_to_ph"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="日曜と同じ"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:textSize="12sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_add_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="行を追加"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_fallback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="?android:attr/colorBackground"
            android:alpha="0.9"
            android:padding="8dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/text_fallback_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="解析できない形式のため直接編集できません" />

            <ImageButton
                android:id="@+id/btn_force_edit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@android:drawable/ic_menu_edit"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="強制的に編集する" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layout_shape_edit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="形状"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/edit_radio_shape"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <RadioButton
                    android:id="@+id/edit_shape_box"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="柱上箱型" />
                <RadioButton
                    android:id="@+id/edit_shape_pillar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="円柱" />
                <RadioButton
                    android:id="@+id/edit_shape_other"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="その他" />
            </RadioGroup>
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_branch_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="収集局名 (operator:branch)"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_branch_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/edit_ref_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ポスト番号 (ref)"
            android:layout_marginBottom="16dp"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edit_ref_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="所在地"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/edit_address_value"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="14sp" />

            <ImageButton
                android:id="@+id/btn_address_edit"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="住所を編集"
                android:src="@android:drawable/ic_menu_edit" />
        </LinearLayout>


        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/layout_save_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="?android:attr/colorBackground"
        android:elevation="8dp">
        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save" />
    </FrameLayout>
</LinearLayout>
